# Mnemosyne Protocol — environment variables
# Copy to .env and fill in your values.

# Storage
MNEMOSYNE_STORAGE_PATH=/data/mnemosyne
MNEMOSYNE_DB_ECHO=false

# Embedding provider (local | openai | ollama | vllm)
MNEMOSYNE_EMBEDDING_PROVIDER=local
MNEMOSYNE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MNEMOSYNE_EMBEDDING_BASE_URL=
MNEMOSYNE_EMBEDDING_API_KEY=
MNEMOSYNE_EMBEDDING_DIMENSIONS=384

# Retrieval
MNEMOSYNE_RETRIEVAL_MODE=hybrid
MNEMOSYNE_RETRIEVAL_TOP_K=10
MNEMOSYNE_RETRIEVAL_VECTOR_WEIGHT=0.6
MNEMOSYNE_RETRIEVAL_GRAPH_WEIGHT=0.4
MNEMOSYNE_RETRIEVAL_MIN_IMPORTANCE=0.1

# Consolidation
MNEMOSYNE_CONSOLIDATION_ENABLED=true
MNEMOSYNE_CONSOLIDATION_INTERVAL_SECONDS=300
MNEMOSYNE_CONSOLIDATION_IMPORTANCE_THRESHOLD=0.3

# Token budget
MNEMOSYNE_TOKEN_BUDGET_TOTAL_CONTEXT_WINDOW=8192
MNEMOSYNE_TOKEN_BUDGET_SYSTEM_RESERVED=512
MNEMOSYNE_TOKEN_BUDGET_RETRIEVAL_RATIO=0.35
MNEMOSYNE_TOKEN_BUDGET_MAX_BLOCKS=20

# Model API keys (set the ones you use)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8000/v1
